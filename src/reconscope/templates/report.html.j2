<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'sha256-{{ style_hash }}'; base-uri 'none'; form-action 'none'">
<title>reconscope report</title>
<style>{{ css|safe }}</style>
</head>
<body>
<header>
  <h1>reconscope report</h1>
  <p class="sub">{{ report.tool }} {{ report.version }} &middot; {{ started }} &rarr; {{ finished }}</p>
  <p class="auth"><strong>Authorization:</strong> {{ report.authorization }}</p>
</header>

<section class="summary">
  <div class="counts">
    {% for severity, count in counts.items() %}
    <span class="pill sev-{{ severity }}">{{ severity }}: {{ count }}</span>
    {% endfor %}
  </div>
  <p class="meta">{{ report.hosts|length }} host(s) scanned &middot; {{ report.requested|length }} requested &middot; {{ report.refused|length }} refused</p>
</section>

{% if report.refused %}
<section class="refused">
  <h2>Refused (out of scope)</h2>
  <ul>
    {% for item in report.refused %}
    <li><code>{{ item.target }}</code> &mdash; {{ item.reason }}</li>
    {% endfor %}
  </ul>
</section>
{% endif %}

{% for host in report.hosts %}
<section class="host">
  <h2>{{ host.host }}{% if host.hostname %} <span class="name">({{ host.hostname }})</span>{% endif %}</h2>
  {% if host.reverse_dns %}<p class="meta">PTR: {{ host.reverse_dns }}</p>{% endif %}

  {% if host.dns %}
  <table class="dns">
    <caption>DNS records</caption>
    {% for rtype, values in host.dns.items() %}
    <tr><th>{{ rtype }}</th><td>{{ values|join(", ") }}</td></tr>
    {% endfor %}
  </table>
  {% endif %}

  <table class="ports">
    <caption>Ports</caption>
    <thead><tr><th>Port</th><th>State</th><th>Service</th><th>Detail</th></tr></thead>
    <tbody>
    {% for port in host.ports if port.state.value == "open" %}
      <tr>
        <td>{{ port.port }}/{{ port.protocol }}</td>
        <td class="state-open">open</td>
        <td>{{ port.service.name if port.service else "unknown" }}</td>
        <td>{{ port.service.product or port.service.banner or "" if port.service else "" }}</td>
      </tr>
      {% if port.service and port.service.details %}
      <tr class="details"><td colspan="4"><pre>{{ port.service.details|tojson(indent=2) }}</pre></td></tr>
      {% endif %}
      {% for finding in port.findings %}
      <tr class="finding"><td colspan="4"><span class="pill sev-{{ finding.severity.value }}">{{ finding.severity.value }}</span> <strong>{{ finding.title }}</strong> &mdash; {{ finding.detail }}</td></tr>
      {% endfor %}
    {% else %}
      <tr><td colspan="4" class="muted">No open ports in scope.</td></tr>
    {% endfor %}
    </tbody>
  </table>

  {% for finding in host.findings %}
  <p class="finding"><span class="pill sev-{{ finding.severity.value }}">{{ finding.severity.value }}</span> <strong>{{ finding.title }}</strong> &mdash; {{ finding.detail }}</p>
  {% endfor %}
</section>
{% endfor %}

<footer>
  <p>Generated by reconscope for authorized use only. Scanning hosts you are not permitted to test may be illegal.</p>
</footer>
</body>
</html>
